# WalletConnect (Reown) project ID. Empty uses the scaffold's shared ID, which is fine on your own
# machine; create your own at https://cloud.reown.com before you put the app anywhere public.
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=

# JSON-RPC endpoint the app reads Hedera testnet through. Empty uses https://testnet.hashio.io/api.
NEXT_PUBLIC_HEDERA_TESTNET_RPC_URL=
