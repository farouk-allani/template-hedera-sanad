# dependencies
node_modules

# env files
.env

# coverage
coverage
coverage.json

# typechain
typechain
typechain-types

# hardhat files
cache
artifacts

# zkSync files
artifacts-zk
cache-zk

# deployments: only the testnet record the app ships pointed at is committed, and a developer's
# own `yarn sanad:setup` overwrites it. Local-node records and compiler inputs stay out.
deployments/*
!deployments/hederaTestnet/
deployments/hederaTestnet/solcInputs/

# typescript
*.tsbuildinfo

# other
temp

# Sanad testnet state: deployment record, resume checkpoint, evidence, and the throwaway
# testnet keys for the demo role holders and buyers. Never commit any of it.
.sanad
