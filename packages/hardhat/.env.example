# Hedera JSON-RPC endpoint (testnet default, change for mainnet)
HEDERA_RPC_URL=https://testnet.hashio.io/api

# Don't fill manually. Run yarn hardhat:account:generate or yarn hardhat:account:import first.
DEPLOYER_PRIVATE_KEY_ENCRYPTED=

# Testnet shortcut for `yarn sanad:setup` and `yarn sanad:test`: the private key of an ECDSA
# account from https://portal.hedera.com, hex or DER, used as-is with no password prompt. It is
# refused for any network other than hederaTestnet. For anything that holds value, leave this
# empty and use the encrypted key above instead.
OPERATOR_KEY=
