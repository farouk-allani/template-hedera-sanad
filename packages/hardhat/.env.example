# Hedera JSON-RPC endpoint (testnet default, change for mainnet)
HEDERA_RPC_URL=https://testnet.hashio.io/api

# Don't fill manually. Run yarn generate or yarn account:import first.
DEPLOYER_PRIVATE_KEY_ENCRYPTED=

# Testnet shortcut for `yarn sanad:setup` and `yarn sanad:test`: the hex ECDSA private key of an
# ECDSA account from https://portal.hedera.com, used as-is with no password prompt. It is refused
# for any network other than hederaTestnet. For anything that holds value, leave this empty and
# use the encrypted key above instead.
OPERATOR_KEY=
